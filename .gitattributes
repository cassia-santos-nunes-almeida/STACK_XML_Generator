
# Synced skill copies are hash-compared byte-for-byte against LF sources in
# my-claude-skills — git must never convert their line endings (2026-07-02).
.claude/skills/** -text

# A8 golden fixtures are byte-compared against generator output (LF) —
# CRLF checkout conversion would fail the gate-stale test on fresh clones.
src/tests/fixtures/golden/*.xml -text

# The import-test pack must stay byte-identical to the golden fixtures —
# what the owner uploads to Moodle is exactly what the gate pinned.
docs/import-test-pack/*.xml -text

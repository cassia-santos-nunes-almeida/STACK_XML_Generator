{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "permissions": {
    "allow": [
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-create-pages"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/../my-claude-skills/scripts/sync-to-projects.sh\" STACK_XML_Generator 2>&1 || echo '[SYNC ERROR] Skill sync FAILED — skills may be outdated or the project is unregistered. Run manually: bash ../my-claude-skills/scripts/sync-to-projects.sh STACK_XML_Generator'"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/../my-claude-skills/scripts/check-skill-edit.sh\"",
            "if": "Write(.claude/skills/**)|Edit(.claude/skills/**)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/../my-claude-skills/scripts/validate-structured-file.sh\""
          }
        ]
      }
    ]
  }
}
